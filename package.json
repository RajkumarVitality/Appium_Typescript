{
  "name": "appium-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx scripts/run-mobile-tests.ts",
    "test:smoke": "cross-env LT_SCENARIO=loginAndLogout tsx scripts/run-mobile-tests.ts --suite smoke",
    "test:regression": "cross-env LT_SCENARIO=lockout tsx scripts/run-mobile-tests.ts --suite regression",
    "test:login": "cross-env LT_SCENARIO=loginAndLogout tsx scripts/run-mobile-tests.ts",
    "test:android": "cross-env PLATFORM=Android LT_SCENARIO=loginAndLogout tsx scripts/run-mobile-tests.ts",
    "test:ios": "cross-env PLATFORM=iOS LT_SCENARIO=loginAndLogout tsx scripts/run-mobile-tests.ts",
    "test:lockout": "cross-env LT_SCENARIO=lockout tsx scripts/run-mobile-tests.ts",
    "test:mha": "cross-env LT_SCENARIO=mha-high-risk tsx scripts/run-mobile-tests.ts",
    "test:mha-high-risk": "cross-env LT_SCENARIO=mha-high-risk tsx scripts/run-mobile-tests.ts",
    "test:screening": "cross-env LT_SCENARIO=screening tsx scripts/run-mobile-tests.ts",
    "test:unit": "node --import tsx --test tests/helpers/*.test.ts",
    "typecheck": "tsc --noEmit",
    "report:generate": "tsx scripts/serve-allure-report.ts",
    "report:open": "tsx scripts/serve-allure-report.ts"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.15.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.30",
    "@wdio/cli": "^9.15.0",
    "@wdio/globals": "^9.15.0",
    "@wdio/local-runner": "^9.15.0",
    "@wdio/mocha-framework": "^9.15.0",
    "@wdio/spec-reporter": "^9.15.0",
    "allure-commandline": "^2.34.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "webdriverio": "^9.15.0"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "serialize-javascript": "7.0.5"
  }
}
